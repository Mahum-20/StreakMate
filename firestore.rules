rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStreakParticipant(streakId) {
      return isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/streaks/$(streakId)).data.participantUids
      );
    }

    function isAccountActive() {
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'deleting'
      );
    }

    // ===============================================================
    // 1. User Profiles (Private to Owner - Protects Email & Sensitive Data)
    // ===============================================================
    match /users/{userId} {
      // Strictly owner-only access to prevent unauthorized email and profile scraping
      allow read: if isOwner(userId);

      // Profile creation: owner only, must match uid, stats initialized to zero
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.username is string;

      // Profile updates from client: strictly limited to safe presentation fields
      // Prevents client tampering with stats, email, username, or uid!
      allow update: if isOwner(userId)
        && isAccountActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'avatarUrl', 'timezone', 'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.username == resource.data.username
        && (!('stats' in resource.data) || request.resource.data.stats == resource.data.stats);

      allow delete: if isOwner(userId);

      match /deviceTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      match /notificationPreferences/{configId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================================
    // 2. Usernames Index (Public Directory for Username Lookup)
    // Contains only public display fields (uid, username, displayName, avatarUrl)
    // ===============================================================
    match /usernames/{username} {
      allow read: if isAuthenticated();
      // Only authenticated user can claim their username, and it MUST strictly match
      // the username assigned in their own user profile document.
      // This eliminates username hoarding and prevents reserving unassigned names!
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      // Immutable once registered; cannot transfer usernames
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ===============================================================
    // 3. Friend Requests (Validated State Machine Transitions)
    // ===============================================================
    match /friendRequests/{requestId} {
      // Only sender and recipient can view their requests
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );

      // Create: must be from current user to a distinct recipient with 'pending' status
      // Anti-spam: enforce deterministic request ID matching fromUid_toUid and prevent duplicate requests
      allow create: if isAuthenticated()
        && isAccountActive()
        && requestId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.id == requestId
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'id', 'fromUid', 'toUid', 'fromDisplayName', 'fromUsername', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.fromDisplayName is string
        && request.resource.data.fromUsername is string
        && !exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + request.resource.data.toUid))
        && !exists(/databases/$(database)/documents/friendships/$(request.resource.data.toUid + '_' + request.auth.uid));

      // Update: strictly validated state machine
      // Recipient can reject; sender can cancel.
      // Acceptance is strictly prohibited from client writes and must go through acceptFriendRequest Cloud Function!
      allow update: if isAuthenticated()
        && isAccountActive()
        && resource.data.status == 'pending'
        && (
          // Recipient can only reject
          (resource.data.toUid == request.auth.uid && request.resource.data.status == 'rejected') ||
          // Sender can cancel while pending
          (resource.data.fromUid == request.auth.uid && request.resource.data.status == 'cancelled')
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;

      // Delete: sender or recipient
      allow delete: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // ===============================================================
    // 4. Friendships (Mutual Connections)
    // ===============================================================
    match /friendships/{friendshipId} {
      // Only the two mutual participants can read their friendship
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantUids;

      // Creation from client: STRICTLY DISABLED.
      // Friendships can ONLY be provisioned by the server-authoritative Cloud Function acceptFriendRequest!
      // This completely closes the acceptance bypass vulnerability.
      allow create: if false;

      // Update: participants cannot be mutated; only activity/metadata can update
      allow update: if isAuthenticated()
        && isAccountActive()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantData', 'activeStreakCount', 'updatedAt']);

      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participantUids;
    }

    // ===============================================================
    // 5. Streaks (Solo & Partner Streaks with Strict Field Constraints)
    // ===============================================================
    match /streaks/{streakId} {
      // Only participating users can view the streak
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantUids;

      // Streak creation: creator must be signed-in, included in participants, and start with 0 streak.
      // Partner streaks require verified mutual friendship to prevent unconsenting additions.
      allow create: if isAuthenticated()
        && isAccountActive()
        && request.resource.data.creatorUid == request.auth.uid
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.currentStreak == 0
        && request.resource.data.longestStreak == 0
        && request.resource.data.status == 'active'
        && (
          (request.resource.data.isSolo == true && request.resource.data.participantUids.size() == 1) ||
          (
            request.resource.data.isSolo == false
            && request.resource.data.participantUids.size() == 2
            && (
              exists(/databases/$(database)/documents/friendships/$(request.resource.data.participantUids[0] + '_' + request.resource.data.participantUids[1])) ||
              exists(/databases/$(database)/documents/friendships/$(request.resource.data.participantUids[1] + '_' + request.resource.data.participantUids[0]))
            )
          )
        );

      // Updating streak from client: strictly locked down to user-controlled metadata
      // (status pause/resume, reminderLeadHours, lastNudgeDismissed).
      // Authoritative streak counters (currentStreak, longestStreak, freezesRemaining,
      // currentPeriodCheckIns, currentPeriodKey, currentPeriodEnd) and nudge initiation
      // can ONLY be mutated by authoritative Cloud Functions via Admin SDK!
      allow update: if isAuthenticated()
        && isAccountActive()
        && request.auth.uid in resource.data.participantUids
        // Core immutable security invariants:
        && request.resource.data.creatorUid == resource.data.creatorUid
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.isSolo == resource.data.isSolo
        // Client cannot modify authoritative streak counters or period boundaries:
        && request.resource.data.currentStreak == resource.data.currentStreak
        && request.resource.data.longestStreak == resource.data.longestStreak
        && request.resource.data.freezesRemaining == resource.data.freezesRemaining
        && request.resource.data.currentPeriodCheckIns == resource.data.currentPeriodCheckIns
        && request.resource.data.currentPeriodKey == resource.data.currentPeriodKey
        && request.resource.data.currentPeriodEnd == resource.data.currentPeriodEnd
        // Constrain client-modifiable keys (nudge authoring locked to Cloud Functions):
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'reminderLeadHours', 'lastNudgeDismissed'
        ])
        // Valid status values that a client can set (pause / resume only)
        && request.resource.data.status in ['active', 'paused'];

      // Deletion from client: STRICTLY DISABLED.
      // Streaks must be deleted exclusively via the server-authoritative deleteStreak Cloud Function
      // to guarantee cascading removal of all subcollections (checkIns, history) and related nudges.
      allow delete: if false;

      // Subcollection: Check-in receipts (Client READ-ONLY; writes strictly reserved to Cloud Functions)
      match /checkIns/{checkInId} {
        allow read: if isStreakParticipant(streakId);
        allow write: if false;
      }

      // Subcollection: History (Client READ-ONLY; writes strictly reserved to Cloud Functions)
      match /history/{periodKey} {
        allow read: if isStreakParticipant(streakId);
        allow write: if false;
      }
    }

    // ===============================================================
    // 6. Social Nudges (Strict Sender & Recipient Security)
    // ===============================================================
    match /nudges/{nudgeId} {
      // Only sender or recipient can view the nudge
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );

      // Creation: strictly reserved to server Cloud Function sendNudge to prevent spoofing
      allow create: if false;

      // Update: only recipient can mark as read
      allow update: if isAuthenticated()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);

      // Delete: sender or recipient
      allow delete: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }
  }
}
